sheriffTab:CreateToggle({
	Name = "Activar Aimbot (Torso)",
	CurrentValue = false,
	Callback = function(val)
		SheriffAimbotEnabled = val
		if aimbotConn then aimbotConn:Disconnect() aimbotConn = nil end
		if not val then return end

		aimbotConn = RunService.RenderStepped:Connect(function()
			if not SheriffAimbotEnabled then return end
			local targetTorso = nil
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= Player and p.Character then
					local char = p.Character
					local hum = char:FindFirstChild("Humanoid")
					if getPlayerRole(p) == "Murderer" and hum and hum.Health > 0 then
						local torso = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
						if torso then
							if IgnoreWallsEnabled then
								targetTorso = torso
								break
							else
								local rayParams = RaycastParams.new()
								rayParams.FilterType = Enum.RaycastFilterType.Exclude
								rayParams.FilterDescendantsInstances = {Player.Character, char}
								local result = workspace:Raycast(Camera.CFrame.Position, (torso.Position - Camera.CFrame.Position), rayParams)
								if not result then
									targetTorso = torso
									break
								end
							end
						end
					end
				end
			end
			if targetTorso then
				Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetTorso.Position)
			end
		end)
	end,
})

