-- Fly
local controls
task.spawn(function()
	local ok2, result = pcall(function()
		return require(Player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
	end)
	if ok2 then controls = result end
end)

local function getMoveVector(hum)
	if controls then
		local ok2, v = pcall(function() return controls:GetMoveVector() end)
		if ok2 and typeof(v) == "Vector3" then return v end
	end
	local cam = workspace.CurrentCamera
	local d = hum.MoveDirection
	local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.01 then return Vector3.zero end
	return Vector3.new(d:Dot(cam.CFrame.RightVector), 0, -d:Dot(flatLook.Unit))
end

local function flyCleanup()
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if lv then lv:Destroy() lv = nil end
	if ao then ao:Destroy() ao = nil end
	if att then att:Destroy() att = nil end
end

local function stopFly()
	flying = false
	flyCleanup()
	local char = Player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	untoggle(flyToggle)
end

local function startFly()
	local char = Player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then
		untoggle(flyToggle)
		return
	end

	flying = true
	flyCleanup()

	att = Instance.new("Attachment")
	att.Parent = root

	lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att
	lv.MaxForce = math.huge
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root

	ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = true
	ao.CFrame = root.CFrame
	ao.Parent = root

	hum.PlatformStand = true

	flyConn = RunService.RenderStepped:Connect(function()
		if not (lv and root.Parent and hum.Parent) or hum.Health <= 0 then
			stopFly()
			return
		end
		local cf = workspace.CurrentCamera.CFrame
		local mv = getMoveVector(hum)
		local dir = cf.RightVector * mv.X + cf.LookVector * (-mv.Z)
		if dir.Magnitude > 1 then dir = dir.Unit end
		lv.VectorVelocity = dir * speed
		ao.CFrame = cf.Rotation
	end)
end

