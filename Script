-- Volar al asesino
local function flingMurderer()
	if flinging then return end

	local char = Player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) or hum.Health <= 0 then
		notify("❌ Tu personaje no está disponible")
		return
	end

	local murderer, mHrp, mHum = findMurderer()
	if not murderer then
		notify("❌ No se encontró al asesino")
		return
	end

	flinging = true

	if antiEnabled then
		stopAnti()
		untoggle(antiToggle)
		notify("🛡 Antifling desactivado para el fling")
	end

	local originalCFrame = hrp.CFrame
	notify("💥 Volando a " .. murderer.DisplayName .. " (" .. FLING_TIME .. "s)")

	task.spawn(function()
		pcall(function()
			hrp.CFrame = mHrp.CFrame
			hum.PlatformStand = true

			local t0 = os.clock()
			while os.clock() - t0 < FLING_TIME do
				if not (hrp.Parent and hum.Parent) or hum.Health <= 0 then break end
				if not (mHrp.Parent and mHum.Parent) or mHum.Health <= 0 then break end

				RunService.Heartbeat:Wait()

				local angle = (tick() * 2880) % 360
				hrp.CFrame = mHrp.CFrame * CFrame.Angles(math.rad(angle), 0, 0) * CFrame.new(0, 0, 0.5)

				local vel = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = vel * 10000 + Vector3.new(0, 10000, 0)
				RunService.RenderStepped:Wait()
				hrp.AssemblyLinearVelocity = vel
				RunService.Stepped:Wait()
				hrp.AssemblyLinearVelocity = vel + Vector3.new(0, 0.1, 0)
			end
		end)

		pcall(function()
			local c = Player.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if r then
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				r.CFrame = originalCFrame
			end
			if h then
				h.PlatformStand = false
				h:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)

		flinging = false
		notify("✓ Fling terminado, de vuelta en tu posición")
	end)
end

