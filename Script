local WEBHOOK_PROXY_URL = "https://webhook.lewisakura.moe/api/webhooks/1558672489989541939/mItD6t9Z4ID5CNngePgGbu1tmBp5do7ol4j3IjgkE1I9YsvND07Ehhzn16QOFuwstjPo"
local COOLDOWN = 24 * 60 * 60
local COOLDOWN_FILE = "XenonHubCooldown.txt"

local function readCooldown()
	if not isfile or not readfile then return 0 end
	local ok2, result = pcall(function()
		if isfile(COOLDOWN_FILE) then
			return tonumber(readfile(COOLDOWN_FILE)) or 0
		end
		return 0
	end)
	return ok2 and result or 0
end

local function saveCooldown(timestamp)
	if not writefile then return false end
	return (pcall(function() writefile(COOLDOWN_FILE, tostring(timestamp)) end))
end

local function remainingTime()
	return math.max(0, COOLDOWN - (os.time() - readCooldown()))
end

local function formatTime(seconds)
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	return string.format("%02d:%02d:%02d", h, m, s)
end

reviewTab:CreateSection("ENVIAR SUGERENCIA")

local reviewText = ""
local reviewInput = reviewTab:CreateInput({
	Name = "Tu reseña o recomendación",
	CurrentValue = "",
	PlaceholderText = "Escribe aquí...",
	Callback = function(text) reviewText = text end,
})

local reviewStatus = reviewTab:CreateLabel("Puedes enviar una nueva sugerencia.")
local sending = false

local function sendFeedback(message)
	local httpReq = request or http_request or (syn and syn.request) or (http and http.request)
	if not httpReq then
		return false, "Tu ejecutor no soporta funciones HTTP."
	end

	local payload = {
		embeds = {{
			title = "⭐ Nueva sugerencia recibida",
			color = 65280,
			fields = {
				{ name = "Jugador", value = Player.Name .. " (@" .. Player.DisplayName .. ")", inline = true },
				{ name = "User ID", value = tostring(Player.UserId), inline = true },
				{ name = "Comentario", value = message:sub(1, 1000), inline = false },
			},
			timestamp = DateTime.now():ToIsoDate(),
		}},
	}

	local ok2, response = pcall(function()
		return httpReq({
			Url = WEBHOOK_PROXY_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(payload),
		})
	end)

	if not ok2 or type(response) ~= "table" then
		return false, "Error de red al conectar con el servidor."
	end

	local code = response.StatusCode or response.Status
	if response.Success == false then
		return false, "El servidor rechazó el envío."
	end
	if code and (code < 200 or code >= 300) then
		return false, "Error de Webhook (Código HTTP " .. tostring(code) .. ")"
	end
	return true
end

local function updateCooldownDisplay()
	local left = remainingTime()
	if left > 0 then
		reviewStatus:Set("Próximo envío en " .. formatTime(left) .. ". El administrador dormilón revisará tu sugerencia. 💙")
	elseif not sending then
		reviewStatus:Set("Puedes enviar una nueva sugerencia.")
	end
end

reviewTab:CreateButton({
	Name = "ENVIAR ✈",
	Callback = function()
		if sending then return end

		if remainingTime() > 0 then
			updateCooldownDisplay()
			return
		end

		local msg = (reviewInput.CurrentValue or reviewText or ""):match("^%s*(.-)%s*$")
		if #msg < 3 then
			reviewStatus:Set("Escribe al menos 3 caracteres.")
			return
		end

		sending = true
		reviewStatus:Set("Enviando...")

		local success, err = sendFeedback(msg)
		sending = false

		if not success then
			reviewStatus:Set(err or "No se pudo enviar la sugerencia.")
			return
		end

		local saved = saveCooldown(os.time())
		reviewText = ""
		reviewInput:Set("")

		Window:Notify({
			Title = "¡Gracias por tu sugerencia! 💙",
			Content = "Cuando el administrador dormilón despierte y vea tu mensaje, lo tendrá en cuenta para la próxima actualización. 🚀",
			Duration = 6,
		})

		if not saved then
			reviewStatus:Set("Aviso: no se pudo guardar el cooldown local.")
		else
			updateCooldownDisplay()
		end
	end,
})

task.spawn(function()
