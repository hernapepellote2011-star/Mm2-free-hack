reachConn = RunService.RenderStepped:Connect(function()
	local char = Player.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	local handle = tool and tool:FindFirstChild("Handle")

	if PreviewMeshEnabled then
		if not previewPart then
			previewPart = Instance.new("Part")
			previewPart.Name = "MeshPreviewNet"
			previewPart.Shape = Enum.PartType.Ball
			previewPart.Material = Enum.Material.ForceField
			previewPart.Color = Color3.fromRGB(0, 255, 255)
			previewPart.Transparency = 0.25
			previewPart.CanCollide = false
			previewPart.Anchored = true
			previewPart.Parent = workspace
		end
		local followPart = handle or char:FindFirstChild("HumanoidRootPart")
		if followPart then
			previewPart.Size = Vector3.new(HitboxReachSize, HitboxReachSize, HitboxReachSize)
			previewPart.CFrame = followPart.CFrame
		end
	elseif previewPart then
		previewPart:Destroy()
		previewPart = nil
	end

	if not MurdererReachEnabled or HitboxReachSize <= 0 or not handle then return end

	handle.CanCollide = false
	handle.Massless = true

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Player and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hrp and (hrp.Position - handle.Position).Magnitude <= HitboxReachSize then
				firetouchinterest(hrp, handle, 0)
				firetouchinterest(hrp, handle, 1)
			end
		end
	end
end)

