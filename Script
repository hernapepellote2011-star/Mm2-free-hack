--// Contador en línea (Firebase)
local Online = (function()
	local DB = "https://nhfkjvgfnlk-default-rtdb.firebaseio.com/online"
	local req = request or http_request or (syn and syn.request) or (http and http.request)
	local myId = tostring(Player.UserId)

	local PING_EVERY, READ_EVERY = 3, 1
	local ALIVE_MS, STALE_MS = 10000, 60000

	local listeners, nextKey = {}, 0
	local token, running = 0, false
	local serverNow, clockAtPing = nil, 0
	local lastCount = nil

	local function code(r)
		return r and (r.StatusCode or (r.Success and 200))
	end

	local function push(n)
		for _, fn in pairs(listeners) do
			task.spawn(pcall, fn, n)
		end
	end

	local function nowMs()
		if not serverNow then return nil end
		return serverNow + (os.clock() - clockAtPing) * 1000
	end

	local function ping()
		local ok2, r = pcall(req, {
			Url = DB .. "/" .. myId .. ".json",
			Method = "PUT",
			Headers = {["Content-Type"] = "application/json"},
			Body = '{".sv":"timestamp"}'
		})
		if ok2 and code(r) == 200 then
			local t = tonumber(r.Body)
			if t then
				serverNow, clockAtPing = t, os.clock()
				return true
			end
		end
		return false
	end

	local function read()
		local ok2, g = pcall(req, {Url = DB .. ".json", Method = "GET"})
		if not ok2 or code(g) ~= 200 then return nil end
		local ok3, data = pcall(HttpService.JSONDecode, HttpService, g.Body)
		if not ok3 or type(data) ~= "table" then return 1 end
		local now = nowMs()
		if not now then return nil end
		local n = 0
		for k, t in pairs(data) do
			if type(t) == "number" then
				if now - t < ALIVE_MS then
					n += 1
				elseif now - t > STALE_MS then
					task.spawn(pcall, req, {Url = DB .. "/" .. k .. ".json", Method = "DELETE"})
				end
			end
		end
		return math.max(n, 1)
	end

	local function start()
		if running or not req then return end
		running = true
		token += 1
		local my = token
		task.spawn(function()
			while running and token == my do
				ping()
				task.wait(PING_EVERY)
			end
		end)
		task.spawn(function()
			while running and token == my do
				local n = read()
				if n ~= lastCount then
					lastCount = n
					push(n)
				end
				task.wait(READ_EVERY)
			end
		end)
	end

	local function stop()
		if not running then return end
		running = false
		token += 1
		lastCount = nil
		if req then
			task.spawn(pcall, req, {Url = DB .. "/" .. myId .. ".json", Method = "DELETE"})
		end
	end

	local function bind(fn)
		nextKey += 1
		local key = nextKey
		listeners[key] = fn
		start()
		if lastCount then task.spawn(pcall, fn, lastCount) end
		return function()
			if listeners[key] == nil then return end
			listeners[key] = nil
			task.delay(2, function()
				if next(listeners) == nil then stop() end
			end)
		end
	end

	return { bind = bind, stop = function() listeners = {} stop() end }
end)()
_G.MM2_ONLINE_STOP = Online.stop

