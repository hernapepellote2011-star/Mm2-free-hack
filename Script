local function cleanup()
	if destroyed then return end
	destroyed = true

	pcall(function() if Spec then Spec:Set(false) end end)
	pcall(destroyProfileButton)

	for _, c in ipairs({ aimbotConn, reachConn, espConn, scanConn, charConn }) do
		if c then pcall(function() c:Disconnect() end) end
	end
	if previewPart then previewPart:Destroy() previewPart = nil end

	pcall(stopAnti)
	pcall(function() if _G.MM2_AF_STOP then _G.MM2_AF_STOP() end end)
	if flying then pcall(stopFly) end
	if invisible then pcall(stopInvisible) end

	pcall(clearCoinESP)
	pcall(clearDroppedGunESP)
	pcall(clearPlayerESP)

	if unbindOnline then pcall(unbindOnline) end
	_G.MM2_HUB_CLEANUP = nil
end

